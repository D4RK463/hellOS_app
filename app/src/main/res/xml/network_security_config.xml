<?xml version="1.0" encoding="utf-8"?>
<!-- HEOS devices and local media servers deliver cover art over plain HTTP, often from hosts
     that are not known in advance (IP addresses in the local network or external CDNs). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
